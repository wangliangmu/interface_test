.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 28rpx;
  color: #636E72;
}

.modal-body {
  padding: 16rpx 32rpx 32rpx;
}

.pay-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.pay-label {
  font-size: 28rpx;
  color: #636E72;
}

.pay-value {
  font-size: 28rpx;
  color: #2D3436;
  max-width: 380rpx;
  text-align: right;
}

.pay-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #E17055;
}

.modal-footer {
  display: flex;
  flex-direction: row;
  border-top: 1rpx solid #E9ECF0;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-cancel {
  color: #636E72;
  border-right: 1rpx solid #E9ECF0;
}

.btn-confirm {
  color: #4F6EF7;
}

.btn-confirm.disabled {
  color: #636E72;
  opacity: 0.6;
}
