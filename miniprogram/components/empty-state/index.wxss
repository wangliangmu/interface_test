.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #636E72;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #4F6EF7, #6C5CE7);
  border-radius: 12rpx;
  padding: 20rpx 64rpx;
}

.empty-btn-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
