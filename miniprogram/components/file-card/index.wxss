.file-card {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.file-card:active {
  background-color: #F8F9FE;
}

.file-card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #4F6EF7, #6C5CE7);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.icon-text {
  font-size: 40rpx;
}

.file-card-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.file-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.file-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
  flex: 1;
  margin-right: 16rpx;
}

.file-card-desc {
  font-size: 24rpx;
  color: #636E72;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.file-card-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.file-card-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.meta-item {
  font-size: 20rpx;
  color: #636E72;
  margin-right: 16rpx;
}

.file-card-price-wrap {
  display: flex;
  align-items: center;
}

.file-card-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #E17055;
}

.file-card-price.free {
  color: #00B894;
}
